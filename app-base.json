{
  "expo": {
    "name": "ascen",
    "slug": "ascen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "ascen",
    "splash": {
      "image": "./assets/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A2FBF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.valtun.ascen"
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "navigationBar": {
        "visible": "immersive"
      },
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.valtun.ascen",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "ascen"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {},
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#0A2FBF"
        }
      ],
      "./plugins/withAscenSplashBackground",
      [
        "expo-notifications",
        {
          "icon": "./assets/splash-logo.png",
          "color": "#0A2FBF"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-sqlite",
      [
        "expo-status-bar", 
        { 
          "style": "auto", "translucent": true 
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Ascen precisa acessar suas fotos para definir a imagem de perfil."
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
