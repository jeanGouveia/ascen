# Copie para .env na raiz do projeto (não commitar .env)

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sua_chave_anon

# Política de privacidade (URL pública — obrigatória na Play Store)
EXPO_PUBLIC_PRIVACY_URL=https://sua-url-de-privacidade

# Google OAuth
# Google Cloud → Credenciais → OAuth → Android
#   Pacote: com.valtun.ascen
#   SHA-1 debug: 5E:8F:16:06:2E:A3:CD:2C:4A:0D:54:78:76:BA:A6:F3:8C:AB:F6:25
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=SEU_CLIENT_ID_ANDROID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=SEU_CLIENT_ID_WEB.apps.googleusercontent.com
