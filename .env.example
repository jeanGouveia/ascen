# Copie para .env na raiz do projeto
#
# === ANDROID (obrigatório no celular) ===
# Google Cloud → Credenciais → Criar credenciais → ID do cliente OAuth → Android
#   Nome do pacote: com.anonymous.ascen
#   SHA-1 (build debug local):
#   5E:8F:16:06:2E:A3:CD:2C:4A:0D:54:78:76:BA:A6:F3:8C:AB:F6:25
# NÃO use ascen:// no cliente Web — o Google rejeita.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=SEU_CLIENT_ID_ANDROID.apps.googleusercontent.com

# === WEB (opcional; usado em iOS/Web) ===
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=SEU_CLIENT_ID_WEB.apps.googleusercontent.com
